# Copy to .env (or export these) before `npm start`.
# Without a key the game still works using the built-in offline planner.
ANTHROPIC_API_KEY=
# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5-5
# PORT=3000
# AI_MAX_REQUESTS_PER_IP=40        # per 15 minutes
# AI_MAX_REQUESTS_PER_DAY=2000      # whole-server daily cap to control spend
# TRUST_PROXY=1                     # set when running behind a reverse proxy
